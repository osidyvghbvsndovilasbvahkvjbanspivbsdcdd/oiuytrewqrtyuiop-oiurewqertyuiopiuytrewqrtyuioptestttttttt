    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.3",
    "crypto-js": "^4.2.0",
    "@upstash/redis": "^1.28.0",
    "react-hot-toast": "^2.4.1",
    "lucide-react": "^0.300.0",
    "date-fns": "^3.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react-draggable": "^4.4.6",
    "react-dropzone": "^14.2.3",
    "zustand": "^4.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",

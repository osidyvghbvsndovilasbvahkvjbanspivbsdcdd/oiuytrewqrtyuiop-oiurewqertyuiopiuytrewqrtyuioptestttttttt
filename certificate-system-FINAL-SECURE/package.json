{
  "name": "certificate-system",
  "version": "1.0.0",
  "description": "Certificate Issuing & Verification System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron electron/main.js",
